<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs SealsAtHome's Unity-free code (serialization rules, settings tables, pup and name rules) against the game's own
    types from assembly_valheim.dll, outside the game. Everything that needs a live Unity engine is tested in game.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- The game assemblies target .NET Framework; they load fine for reflection and plain data classes.
         SYSLIB0050: FieldInfo.IsNotSerialized is obsolete on .NET 8 but is what Unity (net48 / Mono) reads. -->
    <NoWarn>$(NoWarn);NU1701;MSB3277;SYSLIB0050</NoWarn>
    <ValheimDir Condition="'$(ValheimDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Valheim</ValheimDir>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(ValheimDir)/valheim_Data/Managed</ManagedDir>
    <PluginDll Condition="'$(PluginDll)' == ''">$(MSBuildProjectDirectory)/../bin/$(Configuration)/SealsAtHome.dll</PluginDll>
  </PropertyGroup>

  <ItemGroup>
    <!-- Read by HookCheckTests: where the game DLLs and the built plugin are. -->
    <AssemblyMetadata Include="ManagedDir" Value="$(ManagedDir)" />
    <AssemblyMetadata Include="PluginDll" Value="$(PluginDll)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The hook check (HookCheck.cs) reads the built plugin and the game DLLs as files. -->
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <!-- The plugin's Harmony (HarmonyX via BepInEx.Core, the same version as the plugin, so Dependabot moves both
         together), for FakeHooks.cs. ExcludeAssets="build": its targets file keeps Mono.Cecil (and Harmony) out of
         the output, right for a plugin, not for this program. -->
    <PackageReference Include="BepInEx.Core" Version="5.4.21" ExcludeAssets="build" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../src/UnitySerialization.cs" />
    <Compile Include="../src/SealSettings.cs" />
    <Compile Include="../src/SealRules.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="assembly_valheim">
      <HintPath>$(ManagedDir)/assembly_valheim.dll</HintPath>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ManagedDir)/assembly_utils.dll</HintPath>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>$(ManagedDir)/assembly_guiutils.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
